---
interface Props {
	title?: string;
	description?: string;
}

const {
	title = "Puspenkom BKN — Pendaftaran Penilaian Kompetensi",
	description = "Sistem Informasi Pendaftaran Penilaian Kompetensi ASN secara online dan paperless. Pusat Penilaian Kompetensi, Badan Kepegawaian Negara.",
} = Astro.props;
---

<!doctype html>
<html lang="id">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body>
		<slot />
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		min-height: 100vh;
	}
</style>
